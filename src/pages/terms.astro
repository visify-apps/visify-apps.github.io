---
import Section from "../components/Section.astro";
import { mailto, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const lastUpdated = "10 October 2026";
---

<BaseLayout
  title="Terms of use"
  description="Terms of use for the Visify Apps website."
  canonicalPath="/terms"
>
  <Section narrow>
    <p class="label">Legal</p>
    <h1>Terms</h1>
    <p class="meta">Updated {lastUpdated}</p>

    <div class="prose">
      <p>
        These terms apply when you use the {site.shortName} company website.
      </p>

      <h2>The site</h2>
      <p>
        Informational content about {site.name} and our product directory.
        Availability and features of future products may change; listings will
        stay accurate when published.
      </p>

      <h2>No professional advice</h2>
      <p>
        Nothing here is legal, financial, or other professional advice.
      </p>

      <h2>Intellectual property</h2>
      <p>
        Name, marks, and site content belong to us or licensors. Ordinary
        viewing and sharing of public pages is fine; commercial reuse needs
        permission.
      </p>

      <h2>External links</h2>
      <p>
        Third-party sites (stores, docs) have their own terms. We are not
        responsible for their content.
      </p>

      <h2>Disclaimer</h2>
      <p>
        The site is provided “as is” without warranties, to the fullest extent
        permitted by law.
      </p>

      <h2>Liability</h2>
      <p>
        To the fullest extent permitted by law, {site.shortName} is not liable
        for indirect or consequential damages from using this site.
      </p>

      <h2>Contact</h2>
      <p>
        <a href={mailto("Terms enquiry")}>{site.email}</a>
      </p>
    </div>
  </Section>
</BaseLayout>

<style>
  .meta {
    margin-top: var(--space-4);
    margin-bottom: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>
